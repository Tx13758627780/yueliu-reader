{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "selfhost:dev": "node scripts/selfhost.mjs dev",
    "selfhost:build": "node scripts/selfhost.mjs build",
    "selfhost:deploy": "node scripts/selfhost.mjs deploy",
    "test:reader": "node --test tests/reader-content.test.mjs tests/rsshub-instances.test.mjs tests/reader-ai.test.mjs tests/reader-integrations.test.mjs tests/reader-notes.test.mjs tests/reader-workspace.test.mjs tests/reader-offline.test.mjs tests/reader-delivery.test.mjs tests/reader-discovery.test.mjs tests/reader-bili-api.test.mjs",
    "build:offline": "node scripts/build-offline.mjs",
    "build:desktop-api": "node scripts/build-desktop-api.mjs",
    "desktop:dev": "npm run build:offline && npm run build:desktop-api && npm --prefix native start",
    "desktop:windows": "npm run build:offline && npm run build:desktop-api && npm --prefix native run pack:win",
    "android:prepare": "npm run build:offline && node scripts/prepare-android.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@capacitor/core": "^8.5.1",
    "@hookform/resolvers": "^5.7.1",
    "@mozilla/readability": "^0.6.0",
    "@noble/hashes": "^2.0.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.15",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "fast-xml-parser": "^5.11.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
